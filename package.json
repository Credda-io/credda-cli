{
  "name": "@credda/cli",
  "version": "1.0.0",
  "description": "Public source mirror of the Credda CLI command surface. Ships no executable: install the `credda` package for the CLI itself. Replaces the retired 0.x, which was an unrelated product.",
  "license": "MIT",
  "homepage": "https://github.com/Credda-io/credda-cli#readme",
  "bugs": {
    "url": "https://github.com/Credda-io/credda-cli/issues",
    "email": "martin@credda.io"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Credda-io/credda-cli.git"
  },
  "keywords": [
    "credda",
    "cli",
    "mirror",
    "command-surface",
    "debugging",
    "bug-reproduction"
  ],
  "engines": {
    "node": ">=18"
  }
}
