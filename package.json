{
  "name": "@credda/cli",
  "version": "0.1.5",
  "description": "Official Credda CLI — look up and offline-verify portable trust from the terminal: public trust checks, credential verification, platform score reads, share-token minting. A thin client over @credda/js; no scoring logic lives here.",
  "license": "MIT",
  "homepage": "https://github.com/Credda-io/credda-cli#readme",
  "bugs": {
    "url": "https://github.com/Credda-io/credda-cli/issues",
    "email": "martin@credda.io"
  },
  "type": "module",
  "bin": {
    "credda": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@credda/js": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Credda-io/credda-cli.git"
  },
  "keywords": [
    "credda",
    "cli",
    "command-line",
    "trust",
    "reliability-score",
    "verifiable-credentials",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  }
}
